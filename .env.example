# PostgreSQL and SMTP used by the legacy OTP API routes
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/insurchain
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=InsurChain Health <no-reply@example.com>

# Public wallet and contract settings
NEXT_PUBLIC_LOCALHOST_RPC=http://127.0.0.1:8545/
NEXT_PUBLIC_CONTRACT_ADDRESS_LOCALHOST=
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
